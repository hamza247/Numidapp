{
  "expo": {
    "name": "Numidapp",
    "slug": "numidapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "numidapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080C14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.numidapp.app",
      "infoPlist": {
        "NSContactsUsageDescription": "We need access to your contacts to help others find who saved their number."
      }
    },
    "android": {
      "package": "com.numidapp.app",
      "permissions": [
        "READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#E8ECF2",
        "monochromeImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-contacts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}